# Copy to .env (`tradebot init`). Never commit .env.

# Exchange API keys - only needed for live trading.
# Create keys with TRADE permission only. DISABLE WITHDRAWALS. Whitelist your server IP.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (OKX, KuCoin) also need a passphrase:
EXCHANGE_API_PASSWORD=

# Telegram: create a bot with @BotFather, paste the token, message your bot once,
# then run `tradebot telegram-test` to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
